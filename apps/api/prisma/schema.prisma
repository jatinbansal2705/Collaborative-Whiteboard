generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum UserRole {
  USER
  ADMIN
}

enum BoardMemberRole {
  OWNER
  EDITOR
  COMMENTER
  VIEWER
}

enum BoardStatus {
  ACTIVE
  ARCHIVED
}

enum ShareLinkMode {
  PUBLIC
  PRIVATE
}

enum NotificationType {
  INVITE
  COMMENT
  MENTION
  BOARD_SHARED
  CHAT_MENTION
}

enum BoardVersionKind {
  AUTO
  MANUAL
}

enum BoardActivityType {
  CREATE
  EDIT
  VERSION_RESTORE
  MANUAL_VERSION
  ARCHIVE
  DELETE
  RESTORE
}

model User {
  id                 String               @id @default(uuid()) @db.Uuid
  email              String               @unique @db.Citext
  passwordHash       String?              @map("password_hash") @db.VarChar(255)
  name               String?              @db.VarChar(120)
  avatarUrl          String?              @map("avatar_url") @db.VarChar(2048)
  provider           AuthProvider         @default(EMAIL)
  role               UserRole             @default(USER)
  googleId           String?              @unique @map("google_id") @db.VarChar(255)
  emailVerifiedAt    DateTime?            @map("email_verified_at")
  verificationSentAt DateTime?            @map("verification_sent_at")
  isActive           Boolean              @default(true) @map("is_active")
  lastLoginAt        DateTime?            @map("last_login_at")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  deletedAt          DateTime?            @map("deleted_at")
  sessions           Session[]
  passwordResetTokens PasswordResetToken[]
  boardsCreated      Board[]
  boardMemberships   BoardMember[]
  boardFavourites    BoardFavourite[]
  pendingInvites     PendingInvite[]
  comments           Comment[]
  commentThreadsResolved CommentThread[] @relation("ThreadResolver")
  chatMessages       ChatMessage[]
  chatReadReceipts   ChatReadReceipt[]
  notifications      Notification[]
  boardVersions      BoardVersion[] @relation("BoardVersionAuthor")
  boardActivity      BoardActivity[] @relation("BoardActivityActor")

  @@index([role])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  familyId         String    @map("family_id") @db.Uuid
  device           String?   @db.VarChar(512)
  ip               String?   @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at")
  lastUsedAt       DateTime? @map("last_used_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Board {
  id           String          @id @default(uuid()) @db.Uuid
  title        String          @db.VarChar(255)
  data         Json            @default("{}")
  thumbnailUrl String?         @map("thumbnail_url") @db.VarChar(2048)
  isTemplate   Boolean         @default(false) @map("is_template")
  isArchived   Boolean         @default(false) @map("is_archived")
  status       BoardStatus     @default(ACTIVE)
  memberCount  Int             @default(1) @map("member_count")
  /** Monotonic revision counter bumped on every persisted data save (autosave/restore/import). */
  revision     Int             @default(0)
  createdById  String          @map("created_by_id") @db.Uuid
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members      BoardMember[]
  favourites   BoardFavourite[]
  shareLinks   ShareLink[]
  pendingInvites PendingInvite[]
  commentThreads CommentThread[]
  chatMessages ChatMessage[]
  chatReadReceipts ChatReadReceipt[]
  versions     BoardVersion[]
  activity     BoardActivity[]
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  deletedAt    DateTime?       @map("deleted_at")

  @@index([createdById])
  @@index([isArchived])
  @@index([status])
  @@index([title])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, name: "boards_title_trgm_idx")
  @@index([updatedAt])
  @@index([deletedAt])
  @@map("boards")
}

model BoardVersion {
  id            String          @id @default(uuid()) @db.Uuid
  boardId       String          @map("board_id") @db.Uuid
  board         Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  versionNo     Int
  kind          BoardVersionKind @default(AUTO)
  note          String?         @db.VarChar(255)
  data          Json            @default("{}")
  schemaVersion Int             @default(1) @map("schema_version")
  elementCount  Int             @default(0) @map("element_count")
  createdById   String          @map("created_by_id") @db.Uuid
  createdBy     User            @relation("BoardVersionAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([boardId, versionNo])
  @@index([boardId, createdAt])
  @@index([createdById])
  @@map("board_versions")
}

model BoardActivity {
  id        String            @id @default(uuid()) @db.Uuid
  boardId   String            @map("board_id") @db.Uuid
  board     Board             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  type      BoardActivityType
  actorId   String            @map("actor_id") @db.Uuid
  actor     User              @relation("BoardActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  versionNo Int?           @map("version_no")
  details   Json              @default("{}")
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([boardId, createdAt])
  @@index([actorId])
  @@map("board_activity")
}

model BoardMember {
  id        String          @id @default(uuid()) @db.Uuid
  boardId   String          @map("board_id") @db.Uuid
  board     Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String          @map("user_id") @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BoardMemberRole @default(VIEWER)
  addedBy   String?         @map("added_by") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_members")
}

model BoardFavourite {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @map("board_id") @db.Uuid
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([boardId, userId])
  @@index([userId])
  @@map("board_favourites")
}

model ShareLink {
  id          String          @id @default(uuid()) @db.Uuid
  boardId     String          @map("board_id") @db.Uuid
  board       Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  token       String          @unique @db.VarChar(128)
  role        BoardMemberRole @default(VIEWER)
  mode        ShareLinkMode   @default(PRIVATE)
  createdById String?         @map("created_by_id") @db.Uuid
  expiresAt   DateTime?       @map("expires_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  @@index([boardId])
  @@map("share_links")
}

model PendingInvite {
  id          String          @id @default(uuid()) @db.Uuid
  boardId     String          @map("board_id") @db.Uuid
  board       Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  email       String          @db.Citext
  role        BoardMemberRole @default(VIEWER)
  invitedById String          @map("invited_by_id") @db.Uuid
  invitedBy   User            @relation(fields: [invitedById], references: [id], onDelete: Restrict)
  token       String?         @unique @db.VarChar(128)
  expiresAt   DateTime?       @map("expires_at")
  acceptedAt  DateTime?       @map("accepted_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([boardId, email])
  @@index([email])
  @@map("pending_invites")
}

model CommentThread {
  id         String     @id @default(uuid()) @db.Uuid
  boardId    String     @map("board_id") @db.Uuid
  board      Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  x          Float
  y          Float
  resolvedAt DateTime?  @map("resolved_at")
  resolvedBy String?    @map("resolved_by") @db.Uuid
  resolver   User?      @relation("ThreadResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  comments   Comment[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  deletedAt  DateTime?  @map("deleted_at")

  @@index([boardId])
  @@index([resolvedBy])
  @@map("comment_threads")
}

model Comment {
  id        String         @id @default(uuid()) @db.Uuid
  threadId  String         @map("thread_id") @db.Uuid
  thread    CommentThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String         @map("author_id") @db.Uuid
  author    User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String         @db.Text
  mentions  Json           @default("[]")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  deletedAt DateTime?      @map("deleted_at")

  @@index([threadId])
  @@index([authorId])
  @@map("comments")
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  boardId        String   @map("board_id") @db.Uuid
  board          Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  authorId       String   @map("author_id") @db.Uuid
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String?  @db.Text
  attachmentUrl  String?  @map("attachment_url") @db.VarChar(2048)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  readReceipts   ChatReadReceipt[]

  @@index([boardId, createdAt])
  @@index([authorId])
  @@map("chat_messages")
}

model ChatReadReceipt {
  id                String      @id @default(uuid()) @db.Uuid
  boardId           String      @map("board_id") @db.Uuid
  board             Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId            String      @map("user_id") @db.Uuid
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadMessageId String      @map("last_read_message_id") @db.Uuid
  lastReadMessage   ChatMessage @relation(fields: [lastReadMessageId], references: [id], onDelete: Cascade)
  lastReadAt        DateTime    @default(now()) @map("last_read_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  @@unique([boardId, userId])
  @@index([userId])
  @@map("chat_read_receipts")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  payload   Json             @default("{}")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([userId, readAt])
  @@map("notifications")
}
