# Web application environment variables.
# Copy this file to apps/web/.env.local and fill in real values.
# Only NEXT_PUBLIC_* variables are ever inlined into the browser bundle.

# Base URL of the NestJS REST API.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Base URL of the Socket.IO server.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
# Public Google OAuth client id (must match the one configured on the API).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public app origin used for links in emails and OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3001
