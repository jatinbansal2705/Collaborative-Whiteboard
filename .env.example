# =============================================================================
# Collaborative Whiteboard - Environment Variables Reference
# =============================================================================
# Copy this file to the required location and fill in real values.
# NEVER commit real secrets. This file documents every variable the platform
# consumes so each phase can be implemented against a known contract.
#
#   web  -> apps/web/.env.local
#   api  -> apps/api/.env
#   ci   -> GitHub Actions secrets / Docker environment
# =============================================================================

# -----------------------------------------------------------------------------
# Web application (apps/web/.env.local)
# -----------------------------------------------------------------------------
# Base URL of the NestJS REST API.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Base URL of the Socket.IO server.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000
# Public Google OAuth client id (must match the one configured on the API).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Public app origin used for links in emails and OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# API application (apps/api/.env)
# -----------------------------------------------------------------------------
# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug
# Comma-separated list of allowed CORS origins (exact match).
CORS_ORIGINS=http://localhost:3001
# Public URL of the web app (used in emails, share links, redirects).
FRONTEND_URL=http://localhost:3001

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://whiteboard:whiteboard@localhost:5432/whiteboard?schema=public

# Redis (presence, rate-limit buckets, refresh-token denylist, socket adapter)
REDIS_URL=redis://localhost:6379

# Realtime (Socket.IO gateway)
# How long an idle presence entry survives before the member leaves the roster.
REALTIME_PRESENCE_TTL_MS=90000
# Minimum interval between cursor broadcasts per socket (30-50Hz client-side).
REALTIME_CURSOR_MIN_INTERVAL_MS=25

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
# JWT issuer/audience claims (verified on access-token validation)
JWT_ISSUER=collaborative-whiteboard
JWT_AUDIENCE=whiteboard-api
# Email verification tokens
JWT_EMAIL_SECRET=
JWT_EMAIL_EXPIRES_IN=24h
# Password reset tokens (single-use, hashed at rest)
JWT_PASSWORD_RESET_SECRET=
JWT_PASSWORD_RESET_EXPIRES_IN=1h
# Google OAuth handoff code (short-lived code exchanged for tokens by the frontend)
JWT_OAUTH_HANDOFF_SECRET=
JWT_OAUTH_HANDOFF_EXPIRES_IN=5m

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# SMTP (email verification, password reset, notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Collaborative Whiteboard <no-reply@example.com>"

# Cloudinary (image uploads / board thumbnails)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Throttling (global rate limiter)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Throttling (auth endpoints: register/login) - requests per window
AUTH_RATE_LIMIT=5
AUTH_RATE_LIMIT_TTL_MS=60000
# Throttling (forgot-password 3/hour, resend-verification 1/min) - fixed rules
# in apps/api/src/modules/auth/auth.constants.ts

# Observability
SENTRY_DSN=
